# 黑客松演示版 环境变量示例
# 复制本文件为 .env 并填入真实值

# PostgreSQL 数据库连接（本地开发库）
DATABASE_URL=postgres://localhost:5432/inventory_demo

# 阿里云百炼 DashScope API Key（用于 Qwen 系列模型）
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# MiniMax API Key（用于 LLM 对话和图像识别）
MINIMAX_API_KEY=your-minimax-api-key-here

# OpenCode Go API Key（备用 LLM 通道）
OPENCODE_GO_API_KEY=your-opencode-go-api-key-here

# 沙箱邮箱（163/QQ 等，IMAP/SMTP 授权码）
MAIL_USER=
MAIL_PASS=
MAIL_IMAP_HOST=
MAIL_SMTP_HOST=
