# 环境变量配置（复制为 .env 后填入真实值）
# 通义千问 API Key（阿里云百炼平台获取）
DASHSCOPE_API_KEY=sk-your-key-here

# 数据库连接（默认本地 PostgreSQL）
DATABASE_URL=postgres://localhost:5432/inventory_demo

# 沙箱邮箱（仅 demo 演示用，163 授权码认证）
MAIL_USER=yuanyangdemo@163.com
MAIL_PASS=your-authorization-code
MAIL_IMAP_HOST=imap.163.com
MAIL_SMTP_HOST=smtp.163.com
